# ============================================
# Supabase 配置（Supabase Dashboard → Project Settings → API）
# ============================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 管理员邮箱，只有这个邮箱账号可以登录后台（需与 Supabase 建表 SQL 中的策略邮箱一致）


# Cron 接口安全密钥，保护 /api/scheduler（建议 32 位以上随机字符串）
# Vercel Cron 会自动以 Authorization: Bearer <CRON_SECRET> 调用
CRON_SECRET=change-me-to-a-random-secure-string
